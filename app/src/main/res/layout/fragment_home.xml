<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HERO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvHeroBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_badge"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/hero_badge"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark2"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:text="Vẻ đẹp thăng hoa"
                    android:textSize="35sp"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:textColor="@color/dark"
                    android:lineSpacingMultiplier="1.1" />  <!--Khoảng cách giãn dòng-->

                <TextView
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:text="tự nhiên"
                    android:textSize="35sp"
                    android:fontFamily="serif"
                    android:textStyle="bold|italic"
                    android:textColor="@color/lilac3"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hero_subtitle"
                    android:textSize="16sp"
                    android:textColor="@color/dark2"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExplore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_explore"
                        android:background="@drawable/bg_btn_primary"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginEnd="10dp"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btnCampaigns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_campaigns"
                        android:background="@drawable/bg_btn_secondary"
                        android:textColor="@color/dark2"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:stateListAnimator="@null" />

                </LinearLayout>
            </LinearLayout>

            <!-- Rose card -->
            <LinearLayout
                android:layout_width="90dp"
                android:layout_height="140dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_pink">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROSE\nSÉRUM"
                    android:textSize="12sp"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:textColor="@color/dark2"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌹"
                    android:textSize="20sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Scroll dots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@color/white">

            <View android:layout_width="20dp" android:layout_height="6dp"
                android:background="@drawable/bg_badge" android:layout_marginEnd="6dp" />
            <View android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/bg_badge" android:alpha="0.3" android:layout_marginEnd="6dp" />
            <View android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/bg_badge" android:alpha="0.3" />
        </LinearLayout>

        <!-- Brand Strip -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/petal"
            android:scrollbars="none"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Lumière Paris" android:textSize="13sp" android:fontFamily="serif"
                    android:textStyle="bold" android:textColor="@color/dark2" android:alpha="0.6"
                    android:letterSpacing="0.1" android:paddingStart="24dp" android:paddingEnd="24dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✦" android:textSize="13sp" android:textColor="@color/gold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Rose Atelier" android:textSize="13sp" android:fontFamily="serif"
                    android:textStyle="bold" android:textColor="@color/dark2" android:alpha="0.6"
                    android:letterSpacing="0.1" android:paddingStart="24dp" android:paddingEnd="24dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✦" android:textSize="13sp" android:textColor="@color/gold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Velvet Skin" android:textSize="13sp" android:fontFamily="serif"
                    android:textStyle="bold" android:textColor="@color/dark2" android:alpha="0.6"
                    android:letterSpacing="0.1" android:paddingStart="24dp" android:paddingEnd="24dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✦" android:textSize="13sp" android:textColor="@color/gold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Botanica Luxe" android:textSize="13sp" android:fontFamily="serif"
                    android:textStyle="bold" android:textColor="@color/dark2" android:alpha="0.6"
                    android:letterSpacing="0.1" android:paddingStart="24dp" android:paddingEnd="24dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✦" android:textSize="13sp" android:textColor="@color/gold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pure Éclat" android:textSize="13sp" android:fontFamily="serif"
                    android:textStyle="bold" android:textColor="@color/dark2" android:alpha="0.6"
                    android:letterSpacing="0.1" android:paddingStart="24dp" android:paddingEnd="24dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Features -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/features_title"
                android:textSize="20sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textColor="@color/dark" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageCampaigns"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FCE4EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎯" android:textSize="26sp" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Quản lý Chiến dịch" android:textSize="14sp"
                        android:fontFamily="serif" android:textStyle="bold" android:textColor="@color/dark"
                        android:layout_marginBottom="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Khởi tạo &amp; theo dõi tiến độ chiến dịch"
                        android:textSize="12sp" android:textColor="#555555"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardConversionReports"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EDE7F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📈" android:textSize="26sp" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Báo cáo Chuyển đổi" android:textSize="14sp"
                        android:fontFamily="serif" android:textStyle="bold" android:textColor="@color/dark"
                        android:layout_marginBottom="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Phân tích lượt nhận Voucher &amp; mua hàng"
                        android:textSize="12sp" android:textColor="#555555"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardManagePromotions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E0F2F1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎟️" android:textSize="26sp" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Quản lý Ưu đãi" android:textSize="14sp"
                        android:fontFamily="serif" android:textStyle="bold" android:textColor="@color/dark"
                        android:layout_marginBottom="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thiết lập Flash Sale &amp; mã giảm giá"
                        android:textSize="12sp" android:textColor="#555555"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardEngagement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF3E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💬" android:textSize="26sp" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Đo lường Tương tác" android:textSize="14sp"
                        android:fontFamily="serif" android:textStyle="bold" android:textColor="@color/dark"
                        android:layout_marginBottom="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thống kê lượt Like, Share, Comment"
                        android:textSize="12sp" android:textColor="#555555"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>

        <!-- Best Sellers Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Bán chạy nhất"
                android:textSize="20sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textColor="@color/dark" />

            <TextView
                android:id="@+id/tvSeeMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem thêm →"
                android:textSize="13sp"
                android:textColor="#7E57C2"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tỷ trọng Chuyển đổi"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#333"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartConversions"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#B39DDB"/> <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organic (App)"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="24dp"/>

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#F48FB1"/> <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qua Chiến dịch"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:layout_marginStart="8dp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Hiệu quả Chiến dịch"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#333"/>

                    <Spinner
                        android:id="@+id/spinnerCampaigns"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:spinnerMode="dropdown"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="85dp"
                            android:layout_height="wrap_content"
                            android:text="Tương tác"
                            android:textSize="13sp"
                            android:textColor="#333"/>

                        <LinearLayout
                            android:id="@+id/bgBarInteractions"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/barInteractions"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:background="#90CAF9"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvValInteractions"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="85dp"
                            android:layout_height="wrap_content"
                            android:text="Lấy Voucher"
                            android:textSize="13sp"
                            android:textColor="#333"/>

                        <LinearLayout
                            android:id="@+id/bgBarConversions"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/barConversions"
                                android:layout_width="0dp"
                                android:layout_height="30dp"
                                android:background="#FFAB91"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvValConversions"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#333"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top 5 Sản phẩm có lượt quan tâm nhiều nhất"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#333"/>

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartProductConversions"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginTop="8dp"/>

                <LinearLayout
                    android:id="@+id/layoutProductLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View android:layout_width="match_parent" android:layout_height="16dp" />

    </LinearLayout>
</ScrollView>